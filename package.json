{
  "name": "jobfill",
  "version": "0.1.0",
  "description": "Chrome extension that fills job applications from answers you teach it once.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts --watch",
    "playground": "bun run tools/playground/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "zip": "bun run scripts/build.ts --zip",
    "questions": "bun run questions/server.ts",
    "questions:dev": "bunx wrangler dev --config questions/wrangler.toml",
    "questions:deploy": "bunx wrangler deploy --config questions/wrangler.toml"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "latest",
    "@types/chrome": "^0.0.287",
    "elysia": "^1.1.26",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
